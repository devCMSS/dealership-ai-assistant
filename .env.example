# Demo mode seeds fictional inventory and enables demo admin credentials.
DEMO_MODE=true

# Required when DEMO_MODE=false
SECRET_KEY=
ADMIN_USER=admin
# Generate with: python -m app.security hash
ADMIN_PASSWORD_HASH=

# Assistant: auto (Claude when credentials exist, otherwise offline demo) | claude | demo
ASSISTANT_PROVIDER=auto
ASSISTANT_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Set to true behind HTTPS so the session cookie is marked Secure
HTTPS_ONLY=false
